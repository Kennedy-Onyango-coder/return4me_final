{
  "name": "return4me",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.mjs",
    "start": "node dist-server/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "grant-role": "tsx scripts/grant-role.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "dev:preview": "vite --mode demo --host 0.0.0.0",
    "build:preview": "vite build --mode demo",
    "preview:demo": "vite preview --host 0.0.0.0",
    "verify:source": "node scripts/verify-source.mjs",
    "verify:traceability": "node scripts/verify-traceability.mjs",
    "verify:all": "npm run verify:source && npm run verify:traceability && npm run verify:migrations && npm run verify:evidence && npm run verify:admin-overview && npm run verify:admin-audit && npm run verify:admin-queues && npm run verify:admin-access && npm run verify:admin-bulk && npm run verify:admin-step-up && npm run verify:admin-roles && npm run verify:admin-maker-checker && npm run verify:admin-bootstrap && npm run verify:admin-role-management && npm run verify:admin-high-risk && npm run verify:transactional-step-up && npm run test:admin-step-up && npm run test:admin-role-policy && npm run test:admin-maker-checker && npm run test:admin-bootstrap && npm run test:admin-role-management && npm run test:admin-access && npm run test:audit-query && npm run test:admin-queues",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "release:check": "node scripts/check-release-gates.mjs",
    "verify:evidence": "node scripts/verify-evidence-matrix.mjs",
    "verify:admin-overview": "node scripts/verify-admin-overview.mjs",
    "verify:admin-audit": "node scripts/verify-admin-audit-explorer.mjs",
    "test:audit-query": "node --test scripts/test-audit-query.mjs",
    "test:admin-queues": "node --test scripts/test-admin-queue-policy.mjs",
    "verify:admin-queues": "node scripts/verify-admin-queues.mjs",
    "verify:admin-access": "node scripts/verify-admin-access-policy.mjs",
    "verify:admin-bulk": "node scripts/verify-admin-bulk-actions.mjs",
    "verify:admin-step-up": "node scripts/verify-admin-step-up.mjs",
    "test:admin-step-up": "node --test scripts/test-admin-step-up-policy.mjs",
    "test:admin-access": "node --test scripts/test-admin-access-policy.mjs",
    "test:admin-role-policy": "node --test scripts/test-admin-role-policy.mjs",
    "verify:admin-roles": "node scripts/verify-admin-role-policy.mjs",
    "verify:admin-maker-checker": "node scripts/verify-admin-maker-checker.mjs",
    "test:admin-maker-checker": "node --test scripts/test-admin-maker-checker-policy.mjs",
    "verify:admin-bootstrap": "node scripts/verify-admin-bootstrap.mjs",
    "test:admin-bootstrap": "node --test scripts/test-admin-bootstrap-policy.mjs",
    "verify:admin-role-management": "node scripts/verify-admin-role-management.mjs",
    "test:admin-role-management": "node --test scripts/test-admin-role-management-policy.mjs",
    "verify:admin-high-risk": "node scripts/verify-admin-high-risk-step-up.mjs",
    "verify:transactional-step-up": "node scripts/verify-transactional-step-up.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "lucide-react": "^0.546.0",
    "pg": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "resend": "^6.17.2",
    "zod": "^4.1.12",
    "@aws-sdk/client-s3": "^3.922.0",
    "file-type": "^21.0.0",
    "multer": "^2.0.2",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10",
    "tailwindcss": "^4.1.14",
    "esbuild": "^0.25.0",
    "@types/multer": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
