# Local development only. Replace every placeholder with fresh random values.
NODE_ENV=development
PORT=4000
SHUTDOWN_TIMEOUT_MS=15000
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
WEB_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
VITE_DEMO_MODE=false
POSTGRES_PASSWORD=local-dev-only-change-me
DATABASE_URL=postgres://postgres:local-dev-only-change-me@localhost:5432/return4me

# Generate three independent secrets (32+ random bytes each); never reuse values.
SESSION_HASH_SECRET=replace_with_random_secret_at_least_32_characters
OTP_HASH_SECRET=replace_with_a_different_random_secret_at_least_32_chars
CASE_TOKEN_HASH_SECRET=replace_with_a_third_random_secret_at_least_32_chars
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Email delivery remains inactive until valid provider credentials are supplied.
RESEND_API_KEY=
EMAIL_FROM=

# Private file upload. Keep the local directory outside the static web root.
FILE_STORAGE_DRIVER=local
PRIVATE_UPLOAD_DIR=.private-uploads
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# S3-compatible private storage (required for production; do not use public buckets).
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# IntaSend claimant M-Pesa collection (disabled unless explicitly enabled).
INTASEND_COLLECTION_ENABLED=false
INTASEND_ENVIRONMENT=sandbox
INTASEND_SECRET_KEY=
INTASEND_WEBHOOK_CHALLENGE=

# Payment PII protection (independent 32-byte hex keys; keep fingerprint key stable).
PAYMENT_PII_ACTIVE_KEY_VERSION=v1
PAYMENT_PII_ENCRYPTION_KEY_V1=
PAYMENT_PII_ENCRYPTION_KEY_V2=
# Legacy v1 fallback; retain only while migrating existing deployments.
PAYMENT_PII_ENCRYPTION_KEY=
PAYMENT_PII_FINGERPRINT_KEY=
PAYMENT_PII_ROTATION_ENABLED=false

# Refund submission remains disabled until a separate approval and provider acceptance.
INTASEND_REFUND_ENABLED=false

# Payout submission is sandbox-only and disabled by default.
INTASEND_PAYOUT_ENABLED=false
INTASEND_DISBURSEMENT_WALLET_ID=
INTASEND_SETTLEMENT_WALLET_ID=
INTASEND_DISBURSEMENT_WALLET_VERIFIED=false
INTASEND_DISBURSEMENT_WALLET_CURRENCY=
INTASEND_DISBURSEMENT_WALLET_CAN_DISBURSE=false
INTASEND_DISBURSEMENT_WALLET_FUNDS_VERIFIED=false

# Release evidence gates. Keep false until separately reviewed and signed off.
MIGRATIONS_ACCEPTED=false
BACKUP_RESTORE_VERIFIED=false
RPO_RTO_APPROVED=false
SECURITY_REVIEW_SIGNED_OFF=false
PRIVACY_REVIEW_SIGNED_OFF=false
ACCESSIBILITY_REVIEW_SIGNED_OFF=false
PAYMENT_ACCOUNTING_REVIEW_SIGNED_OFF=false
KENYA_LEGAL_REVIEW_SIGNED_OFF=false
PILOT_APPROVED=false
COMMUNICATIONS_PUBLISH_ENABLED=false
EMAIL_NOTIFICATIONS_ENABLED=false
SMS_NOTIFICATIONS_ENABLED=false

# Optional Resend Svix webhook secret for signed delivery/bounce/complaint events.
RESEND_WEBHOOK_SECRET=

# Governance preflight flags. These remain false until the matching evidence is recorded
# and separately approved. Environment values are not cryptographic signatures or release authority.
SOURCE_BASELINE_HASH_VERIFIED=false
REQUIREMENT_RECONCILIATION_SIGNED_OFF=false
CHANGE_CONTROL_APPROVED=false
INDEPENDENT_ACCEPTANCE_COMPLETE=false
OWNER_RELEASE_APPROVAL=false
